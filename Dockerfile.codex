# Build on another trusted machine when the VPS has little free memory/disk.
FROM node:24-trixie-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client ca-certificates \
 && rm -rf /var/lib/apt/lists/*
FROM base AS build
ARG NPM_REGISTRY
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/backend/package.json packages/backend/
COPY packages/contracts/package.json packages/contracts/
COPY industry/package.json industry/
COPY site/package.json site/
RUN npm ci --no-audit --no-fund ${NPM_REGISTRY:+--registry=$NPM_REGISTRY}
COPY . .
RUN npm run build -w @aihot/web && npm prune --omit=dev --no-audit --no-fund
FROM base
# Required exact version; deployment checks npm's official registry and records the selected version.
ARG CODEX_VERSION
RUN test -n "$CODEX_VERSION" && npm install -g --no-audit --no-fund "@openai/codex@$CODEX_VERSION" && npm cache clean --force
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /data /codex && chown node:node /data /codex
USER node
CMD ["node","modules/fde-research/worker.ts"]
