# Copy to .env ONLY for a new deployment. Never overwrite an existing .env.
SITE_URL=http://localhost:3100
PORT=127.0.0.1:3100
TRUST_PROXY=false
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
POSTGRES_PASSWORD=
# Never put subscription OAuth tokens here. Login through the official CLI.
FDE_CODEX_HOME=/var/lib/fde-observer/codex
# Resolve from the official registry, test flags, then freeze the exact version here.
CODEX_VERSION=
FDE_IMAGE=fde-codex-app:local
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FDE_CODEX_ENABLED=false
FDE_DAILY_LIMIT=5
FDE_CODEX_MODEL=
FDE_CODEX_REASONING=low
FDE_MAX_INPUT_CHARS=16000
FDE_CODEX_TIMEOUT_MS=180000
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
# Optional, random >=16 chars, only needed for historical imports:
INGEST_TOKEN=
