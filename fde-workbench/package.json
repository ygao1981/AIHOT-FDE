{
  "name": "fde-workbench",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "intake": "node --env-file-if-exists=.env scripts/intake.mjs",
    "sources:check": "node --env-file-if-exists=.env scripts/sources-check.mjs",
    "backup": "node --env-file-if-exists=.env scripts/manage.mjs backup",
    "export": "node --env-file-if-exists=.env scripts/manage.mjs export"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.12.1",
    "ipaddr.js": "2.2.0",
    "linkedom": "0.18.15",
    "undici": "8.12.3"
  }
}
