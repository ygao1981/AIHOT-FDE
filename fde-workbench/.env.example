# Independent personal workbench. Do not use the legacy root .env or Compose.
FDE_HOST=127.0.0.1
FDE_PORT=3210
FDE_BASE_URL=http://127.0.0.1:3210
FDE_DATA_DIR=.data
# npm run init writes a random private login token here. Never commit it.
FDE_ACCESS_TOKEN=

# Scheduled collection and model work are initially disabled.
FDE_COLLECT_ENABLED=false
# 可选。采集专用本机 HTTP CONNECT 代理，填写已核实的回环地址和端口。
FDE_SOURCE_PROXY_URL=
# 可选。逗号分隔的备用本机 HTTP CONNECT 端点，按填写顺序尝试。
FDE_SOURCE_PROXY_FALLBACK_URLS=
# 可选。GitHub Discussion 的免费只读凭据。公开 REST 读取无需填写。
FDE_GITHUB_DISCUSSIONS_TOKEN=
FDE_ANALYSIS_ENABLED=false
FDE_AUTO_ANALYZE=false
# off | api | codex. Explicit choice; no automatic fallback.
FDE_MODEL_PROVIDER=off
# 滚动 24 小时的自动分析默认上限。用量页保存的值优先。
FDE_DAILY_LIMIT=5
# UTC calendar month, API mode only. Unknown attempts retain their reservation.
FDE_MONTHLY_BUDGET_USD=10
FDE_MAX_INPUT_CHARS=16000
FDE_MAX_OUTPUT_TOKENS=2500
# API writing output cap. Codex CLI uses bounded instructions, not a hard token cap.
FDE_EDITORIAL_MAX_OUTPUT_TOKENS=4500
FDE_MODEL_TIMEOUT_MS=180000
FDE_REASONING=low

# Official Responses API only. No API key is needed in codex mode.
OPENAI_API_KEY=
FDE_API_MODEL=gpt-6.2-sol
# USD / million tokens, Standard speed; verify on the official pricing page.
# Checked 2026-11-20. Includes no assumed cache discount.
FDE_API_INPUT_PRICE=2
FDE_API_OUTPUT_PRICE=10

# Official Codex CLI, installed separately. Use a dedicated login directory.
# Absolute executable and directory paths are required when provider=codex.
FDE_CODEX_BIN=
FDE_CODEX_HOME=
FDE_CODEX_MODEL=
# Optional Docker CLI override only. Choose an exact version after CLI checks.
FDE_CODEX_VERSION=
FDE_CODEX_HOST_DIR=

# Store text only, not screenshots/video. Only unselected raw candidates expire.
FDE_RAW_RETENTION_DAYS=60
FDE_MAX_ARTICLES=10000

# Usually inherited from the system or service environment. Keep these examples commented;
# assigning an empty PATH or proxy value would override the inherited configuration.
# PATH=
# HTTP_PROXY=
# HTTPS_PROXY=
# Proxy URLs may contain credentials. Configure them privately; never commit real values.
